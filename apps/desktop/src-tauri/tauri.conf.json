{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MathSlot",
  "version": "2.2.1",
  "identifier": "io.mathslot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MathSlot",
        "width": 900,
        "height": 580,
        "minWidth": 560,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Utility",
    "shortDescription": "Visual-first keyboard-flow math formula editor",
    "longDescription": "MathSlot is a visual-first, keyboard-flow LaTeX math formula editor with live 2D KaTeX editing, floating which-key command chords, and instant slot navigation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/MathSlot.desktop.hbs",
        "files": {
          "/usr/share/applications/io.mathslot.desktop.desktop": "linux/io.mathslot.desktop.desktop",
          "/usr/share/applications/mathslot.desktop": "linux/mathslot.desktop",
          "/usr/share/icons/hicolor/scalable/apps/mathslot.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "linux/MathSlot.desktop.hbs",
        "files": {
          "/usr/share/applications/io.mathslot.desktop.desktop": "linux/io.mathslot.desktop.desktop",
          "/usr/share/applications/mathslot.desktop": "linux/mathslot.desktop",
          "/usr/share/icons/hicolor/scalable/apps/mathslot.svg": "icons/icon.svg"
        }
      }
    }
  }
}
