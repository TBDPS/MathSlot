#!/usr/bin/env xdg-open
[Desktop Entry]
Name=MathSlot
GenericName=Math Formula Editor
Comment=Ultra-lightweight stream-first math formula editor exporting LaTeX
Exec=mathslot-desktop %U
Icon=mathslot
Terminal=false
Type=Application
Categories=Science;Math;
StartupWMClass=mathslot-desktop
Keywords=math;latex;formula;editor;symbols;calculus;
MimeType=text/x-tex;
