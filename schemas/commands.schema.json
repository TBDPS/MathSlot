{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mathslot.dev/schemas/commands.schema.json",
  "$comment": "@generated by xtask. DO NOT EDIT.",
  "title": "MathSlotCommandsCatalog",
  "description": "JSON Schema for MathSlot command catalog",
  "type": "object",
  "required": [
    "commands"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "keys",
          "label",
          "category",
          "glyph",
          "latex",
          "doc",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "structure",
              "calculus",
              "matrix",
              "accent",
              "greek",
              "symbol",
              "relation",
              "setlogic"
            ]
          },
          "glyph": {
            "type": "string",
            "minLength": 1
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latex": {
            "type": "string",
            "minLength": 1
          },
          "doc": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^▸.+"
            },
            "minItems": 1
          },
          "is_default": {
            "type": "boolean"
          },
          "wrap_body_slot": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
